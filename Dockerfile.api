FROM alpine:latest

WORKDIR /app

# Instalar dependências C++ necessárias para executar binários compilados com Bun
RUN apk add --no-cache libstdc++ libgcc

# Copiar o binário pré-compilado do diretório de build
COPY build/api /app/api

# Dar permissão de execução
RUN chmod +x /app/api

# Variáveis de ambiente padrão
ENV PORT=3000
EXPOSE 3000

# Iniciar o serviço
CMD ["./api"]

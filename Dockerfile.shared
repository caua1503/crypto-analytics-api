FROM oven/bun:alpine AS runtime

WORKDIR /app


RUN apk add --no-cache libstdc++ libgcc
COPY build/shared /app/shared

COPY apps/shared/prisma /app/prisma
COPY apps/shared/prisma.config.ts /app/prisma.config.ts
COPY apps/shared/prisma.user.config.ts /app/prisma.user.config.ts
COPY apps/shared/package.json /app/package.json


RUN chmod +x /app/shared

CMD ["./shared"]

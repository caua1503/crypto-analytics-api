{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "paths": {
            "@repo/shared": [
                "../shared/src/index.ts"
            ],
            "@repo/shared/env": [
                "../shared/src/utils/env.ts"
            ],
            "@repo/shared/integrations": [
                "../shared/src/integrations/index.ts"
            ],
            "@repo/shared/services/*": [
                "../shared/src/services/*.ts"
            ],
            "@repo/shared/types": [
                "../shared/src/types"
            ],
            "@repo/shared/types/common": [
                "../shared/src/types/common.ts"
            ],
            "@repo/shared/types/schemas/*": [
                "../shared/src/types/schemas/*.ts"
            ],
            "@repo/shared/types/interfaces/*": [
                "../shared/src/types/interfaces/*.ts"
            ],
            "@repo/shared/core/*": [
                "../shared/src/core/*.ts"
            ]
        },
        "baseUrl": ".",
        "outDir": "build"
    },
    "include": [
        "src",
        "generated"
    ],
    "exclude": [
        "node_modules",
        "prisma"
    ]
}
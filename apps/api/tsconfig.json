{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "paths": {
            "@repo/shared": [
                "../shared/src/index.ts"
            ],
            "@repo/shared/types": [
                "../shared/src/types/"
            ]
        },
        "baseUrl": ".",
        "outDir": "build"
    },
    "include": [
        "src",
        "generated"
    ],
    "exclude": [
        "node_modules",
        "prisma"
    ]
}
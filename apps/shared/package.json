{
  "name": "@repo/shared",
  "version": "1.0.0",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/utils/env.ts",
    "./integrations": "./src/integrations/index.ts",
    "./services/*": "./src/services/*.ts",
    "./types": "./src/types",
    "./types/common": "./src/types/common.ts",
    "./types/schemas/*": "./src/types/schemas/*.ts",
    "./types/interfaces/*": "./src/types/interfaces/*.ts"
  },
  "scripts": {
    "lint": "bunx @biomejs/biome format --write",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "migrate": "bun run migrate.ts",
    "build": "bun build --compile --minify --bytecode --sourcemap migrate.ts --outfile ../../build/shared"
  },
  "type": "module",
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "axios": "^1.13.4",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.9.2",
    "pg": "^8.17.1",
    "prisma": "^7.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0"
  }
}
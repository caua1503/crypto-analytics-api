{
	"name": "@repo/shared",
	"version": "1.0.0",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./env": "./src/utils/env.ts",
		"./integrations": "./src/integrations/index.ts",
		"./services/*": "./src/services/*.ts",
		"./types": "./src/types",
		"./types/common": "./src/types/common.ts",
		"./types/schemas/*": "./src/types/schemas/*.ts",
		"./types/interfaces/*": "./src/types/interfaces/*.ts",
		"./core/*": "./src/core/*.ts"
	},
	"scripts": {
		"lint": "bunx @biomejs/biome check --write",
		"check": "bunx @biomejs/biome check",
		"db:generate": "prisma generate && prisma generate --config=prisma.user.config.ts",
		"db:migrate": "prisma migrate deploy && prisma migrate deploy --config=prisma.user.config.ts",
		"db:dev": "prisma migrate dev && prisma migrate dev --config=prisma.user.config.ts",
		"db:generate:market": "prisma generate",
		"db:generate:user": "prisma generate --config=prisma.user.config.ts",
		"db:migrate:market": "prisma migrate deploy",
		"db:migrate:user": "prisma migrate deploy --config=prisma.user.config.ts",
		"db:dev:market": "prisma migrate dev",
		"db:dev:user": "prisma migrate dev --config=prisma.user.config.ts",
		"migrate": "bun run migrate.ts",
		"build": "bun build --compile --minify --bytecode --sourcemap migrate.ts --outfile ../../build/shared",
		"dev": "bun i && bun run lint && bun run db:generate && bun run migrate"
	},
	"type": "module",
	"dependencies": {
		"@fastify/sensible": "^6.0.4",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@types/bun": "^1.3.11",
		"axios": "^1.13.4",
		"crypto": "^1.0.1",
		"dotenv": "^17.2.3",
		"fastify": "^5.8.4",
		"fastify-type-provider-zod": "^6.1.0",
		"http-status-codes": "^2.3.0",
		"ioredis": "^5.9.2",
		"pg": "^8.17.1",
		"prisma": "^7.2.0",
		"zod": "4.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.3.0",
		"@types/pg": "^8.16.0"
	}
}

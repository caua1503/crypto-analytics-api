// This is the Prisma schema file for User-related models.
// It uses a separate database connection and generates a distinct Prisma Client.

generator client {
  provider = "prisma-client"
  output   = "../../generated/user-prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  FREE
  PRO
  TRADER
  ADMIN
}

// MODELS

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid

  email        String @unique
  passwordHash String

  role Role @default(FREE)

  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt DateTime?

  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  autoDeleteAt DateTime? //A conta sera realmente apagada apos 90 dias

  extras   UserExtras?
  sessions UserSession[]
  apiKeys  UserApiKey[]
}

model UserExtras {
  id     Int @id @default(autoincrement())
  userId Int @unique

  name   String
  avatar String?
  phone  String?

  user User @relation(fields: [userId], references: [id])
}

model UserSession {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRevoked Boolean @default(false)

  ip        String?
  userAgent String?
  device    String?

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  metadata Json?

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, isRevoked])
}

model UserApiKey {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  apiKeyHash String @unique

  scopes String[]

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  ipWhitelist String[]

  metadata Json?

  @@index([userId])
  @@index([isActive])
}

model ApiRequestLog {
  id Int @id @default(autoincrement())

  userId Int?

  ip         String?
  method     String
  endpoint   String
  statusCode Int
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
